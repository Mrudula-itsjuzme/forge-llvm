FROM ubuntu:24.04

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       clang-18 cmake llvm-18-dev llvm-18-tools ninja-build python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
CMD ["bash", "-lc", "cmake -S . -B build-docker -G Ninja -DLLVM_DIR=$(/usr/lib/llvm-18/bin/llvm-config --cmakedir) -DCMAKE_CXX_COMPILER=clang++-18 -DCMAKE_BUILD_TYPE=Release && cmake --build build-docker && ctest --test-dir build-docker --output-on-failure"]
